session:
  name: Task execution
  code_source: 'DO_ACTION.py'
  environment:
  loop:
    IF_AVAILABLE:
      description: "Check if we have ongoing actions"
      type: if
      input: 
        - filesystem:
            code_dir: /agentlife/current_work/action
      action:
        executor: if
        config: 
          condition_func: isDirEmpty
          condition_func_args: 
            - /agentlife/current_work/action
          condition_func_true: _exit
          condition_func_false: DO_ACTION

    DO_ACTION:
      description: "Read tasks and resolve them"
      type: llm
      input:
        - filesystem:
            code_dir: /agentlife/current_work/action
      output:
        - filesystem:
            code_dir: /agentlife/current_work/action
      action:
        executor: llm
        model: deepseek-chat
        prompt: DO_ACTION_PROMPT
        system_content: SYSTEM_EXECUTE_TASK

